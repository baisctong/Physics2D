# ---- local toolchain binaries are intentionally kept OUTSIDE the repo ----
# scripts/bootstrap.ps1 installs helper binaries under %LOCALAPPDATA%\Physics2D\tools
# (some sandboxed environments deny file writes to executables inside the workspace).

# ---- third-party sources downloaded by FetchContent fallback ----
third_party/_deps/

# ---- local CMake user presets (machine specific) ----
CMakeUserPresets.json

